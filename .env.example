# Copy to .env.local (gitignored) and fill in. Used by tools/showcase-stream.mjs
# to publish output/*.mp4 to Cloudflare Stream for the public showcase site.

# Same Cloudflare account the masterclass videos live on.
CLOUDFLARE_ACCOUNT_ID=
# API token with Stream:Edit. Create at dash.cloudflare.com > My Profile > API Tokens.
CLOUDFLARE_STREAM_TOKEN=

# Hostnames the Stream player is allowed to run on, comma-separated, no scheme.
# The showcase videos are public (no signed URLs), so this is what stops someone
# lifting a uid and embedding the concert on their own page.
# Apply changes with: node tools/showcase-stream.mjs --set-origins
SHOWCASE_ORIGINS=
